# Server-only catalog and auth backend origin (no /api suffix)
MARIHANDMADE_API_URL="http://localhost:3001"
# Server-only private variables
DATABASE_URL="postgresql://replace_me"
DIRECT_URL="postgresql://replace_me"
GUEST_ORDER_TOKEN_SECRET="replace_me"
GOOGLE_OAUTH_SECRET="replace_me"
RESEND_API_KEY="replace_me"
EMAIL_FROM="MarìShop <orders@your-production-domain.com>"
RESEND_FROM_EMAIL="MarìShop <orders@your-production-domain.com>"
EMAIL_SEND_MODE="resend"
ORDER_OWNER_EMAIL="ops@your-production-domain.com"
PAYPAL_CLIENT_ID="replace_me"
PAYPAL_CLIENT_SECRET="replace_me"
PAYPAL_WEBHOOK_ID="replace_me"
PAYPAL_API_BASE_URL="paypal_live_or_sandbox_api_base_url"
PAYPAL_CURRENCY_CODE="EUR"
PAYPAL_RETURN_BASE_URL="https://your-production-domain.com"

# Safe public variables
NEXT_PUBLIC_URL="https://your-production-domain.com"
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
NEXT_PUBLIC_GOOGLE_OAUTH_ID="replace_me_if_google_oauth_is_enabled"
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URL="https://your-production-domain.com/api/auth/google/callback"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="replace_me_if_cloudinary_uploads_are_enabled"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="replace_me_if_cloudinary_uploads_are_enabled"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="replace_me_if_google_analytics_is_enabled"

# Development-only optional variables
NODE_ENV="development"

# Local storefront: NEXT_PUBLIC_APP_URL="http://localhost:7777"
# Configure AUTH_TRUSTED_ORIGINS on the BACKEND to exactly match that origin.
# Production: set NEXT_PUBLIC_APP_URL to the real HTTPS storefront origin and
# include that exact origin in backend AUTH_TRUSTED_ORIGINS (no trailing slash).
# GUEST_ORDER_TOKEN_SECRET is required in development too; use an independent secret.
