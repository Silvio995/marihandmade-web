{
    "extends": "next",
    "ignorePatterns": [
        "src/generated/client/**"
    ],
    "rules": {
        "react/prop-types": 0,
        "react/no-unescaped-entities": 0,
        "@next/next/no-server-import-in-page": 0,
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-empty-object-type": "off"
    }
}
